<% include ../partials/header %>

<div class="container">

    <header class="jumbotron">
        <div class="container"> <%# this is to have extra space around the container %>
            <h1>Welcome to YelpCamp!</h1>
            <p>View all our Campgrounds</p>
            <p>
                <a class="btn btn-primary btn-lg" href="/campgrounds/new">Add New Campground</a>
            </p>
        </div>
    </header>

    <div class="row text-center" style="display: flex; flex-wrap: wrap;"> <%# this is for the grid -- style is for vertical alignment of the grid %>

        <% campgrounds.forEach(function(campground){ %>
            <div class="col-md-3 col-sm-6">
                <div class="card">
                    <img class="card-img-top" src="<%= campground.image %>" alt="">
                    <div class="card-body">
                        <h4 class="card-title"><%= campground.name %></h4>
                        <%# use _id to pick the db id %>
                        <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary">More Info</a>
                    </div>
                </div>           
            </div>
        <% }); %>

    </div>
</div>

<% include ../partials/footer %>