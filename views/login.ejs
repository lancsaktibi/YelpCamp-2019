<% include partials/header %>

<div class="container">
            <p class="text-center">
            <h1>Login</h1>
        </p>

    <div class="row" style="width: 50%; margin: 0 auto;">
        <form action="/login" method="POST">
            <div class="form-group">
                <input class="form-control" type="text" name="username" placeholder="username">
